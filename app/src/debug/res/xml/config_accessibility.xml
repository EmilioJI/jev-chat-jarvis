<?xml version="1.0" encoding="utf-8"?>
<!--
  Internal/debug acceptance only.

  Release/main stays isAccessibilityTool=false. This debug override exists only
  to test user-triggered standard-node reads on Android 16 devices where apps
  mark visible chat content accessibilityDataSensitive.

  WeChat is intentionally NOT added to packageNames, so this build still does
  not subscribe to WeChat Accessibility events. The app must not use WeChat
  resource ids, automatic node capture, UI automation, SET_TEXT/PASTE/CLICK, or
  automatic sending.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:packageNames="com.tencent.mobileqq,com.ss.android.lark,com.twitter.android"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:notificationTimeout="150"
    android:isAccessibilityTool="true"
    android:intro="@string/a11y_intro"
    android:description="@string/a11y_desc" />
